# ── 網頁（web/.env.local，也要設在 Vercel）────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── worker（根目錄 .env，docker compose 會讀）──────────────
SUPABASE_URL=https://xxxx.supabase.co
# 會繞過 RLS，只放 worker，不要進前端、不要進 git
SUPABASE_SERVICE_ROLE_KEY=
# playwright（預設）或 mock
DATA_SOURCE=playwright
MAX_POSTS=30
CACHE_MINUTES=30
POLL_MS=5000
HEADLESS=true

# 本機 Windows 可設 msedge 改用內建 Edge；Docker 裡留空
BROWSER_CHANNEL=

# 登入狀態檔路徑（npm run login -w worker 產生），留空就用未登入模式
THREADS_STORAGE_STATE=
