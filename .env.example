# ── 網頁（放 web/.env.local；部署時填到 Vercel 的 Environment Variables）──
# Supabase 專案 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# anon / publishable key，可公開，所有讀寫都受 RLS 限制
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── worker（放根目錄 .env；docker compose 也讀這個檔）────────────
SUPABASE_URL=https://xxxx.supabase.co
# service_role / secret key：會繞過 RLS，只放 worker，不要進前端、不要進 git
SUPABASE_SERVICE_ROLE_KEY=

# 資料抓取設定
# playwright（預設，真實爬取）或 mock（假資料，只用來測流程；報告會標示「mock」）
DATA_SOURCE=playwright
# 每個帳號抓幾篇主貼文（題目要求至少 30）
MAX_POSTS=30
# 同一帳號在幾分鐘內重複分析就用快取，不重新爬
CACHE_MINUTES=30
# 是否逐篇打開貼文頁補曝光數（每帳號多約 3 分鐘）；false 則曝光數為空，Top 5 改用總互動排序
FETCH_VIEWS=true
# worker 多久查一次有沒有新任務（毫秒）
POLL_MS=5000
# false 會開出看得到的瀏覽器視窗，除錯用
HEADLESS=true
# 用本機已安裝的瀏覽器，例如 Windows 填 msedge；Docker 裡留空（用映像內建的 Chromium）
BROWSER_CHANNEL=
# 副帳號登入狀態檔（npm run login -w worker 產生）；留空或檔案不存在就用未登入模式（約只能拿到 28 篇）
THREADS_STORAGE_STATE=.auth/threads.json
# 選填：設定後 worker 用 Claude 產生內容策略建議；留空則只顯示規則式觀察
ANTHROPIC_API_KEY=
